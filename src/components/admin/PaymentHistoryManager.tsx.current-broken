"use client";

import { useState, useEffect } from 'react';
import { supabaseBrowser } from '../../lib/supabase-browser';
import {
    Plus,
    Check,
    X,
    FileText,
    Clock,
    AlertCircle,
    Trash2,
    DollarSign,
    Calendar,
    ArrowRight
} from 'lucide-react';
import { format } from 'date-fns';
import { pt } from 'date-fns/locale';
import { calculateInstallmentStatus, type InstallmentStatus } from '../../lib/utils';

interface Payment {
    id: string;
    amount: number;
    method: string;
    status: string;
    receipt_url?: string;
    notes?: string;
    created_at: string;
    verified_at?: string;
    deleted?: boolean;
    deleted_at?: string;
    deleted_by?: string;
    edit_history?: Array<{
        edited_at: string;
        old_amount: number;
        new_amount: number;
        edited_by?: string;
    }>;
}

interface PaymentHistoryManagerProps {
    bookingId: string;
    totalAmount: number;
    paidAmount: number;
    paymentPlan?: any[];
    depositValue?: number;
    payments: Payment[];  // ← ADDED: receive payments from parent
    onUpdate: () => void;
}

export default function PaymentHistoryManager({
    bookingId,
    totalAmount,
    paidAmount,
    paymentPlan = [],
    depositValue: propDepositValue,
    payments: propsPayments = [],  // ← ADDED: receive from parent
    onUpdate
}: PaymentHistoryManagerProps) {
    // Removed: const [payments, setPayments] = useState<Payment[]>([]);
    // Removed: const [loading, setLoading] = useState(true);
    const [showAddForm, setShowAddForm] = useState(false);
    const [isSubmitting, setIsSubmitting] = useState(false);

    // Form state
    const [newAmount, setNewAmount] = useState('');
    const [newMethod, setNewMethod] = useState('bank_transfer');
    const [newNote, setNewNote] = useState('');
    const [newLabel, setNewLabel] = useState('');

    // Edit state
    const [editingPaymentId, setEditingPaymentId] = useState<string | null>(null);
    const [editForm, setEditForm] = useState<{ amount: string; method: string; notes: string }>({ amount: '', method: '', notes: '' });

    // Calculate installment status for admin view
    // Calculate installment status for admin view
    const depositValue = propDepositValue || (totalAmount * 0.2); // Use prop or fallback to 20%

    // Parse payment_plan if it's a JSON string
    const parsedPaymentPlan = Array.isArray(paymentPlan)
        ? paymentPlan
        : (typeof paymentPlan === 'string' ? JSON.parse(paymentPlan) : []);

    const installments = calculateInstallmentStatus(
        paidAmount,
        depositValue,
        parsedPaymentPlan,
        propsPayments  // ← Use prop instead of state
    );

    // Removed fetchPayments function - now receiving payments from parent
    // Removed useEffect - no longer needed


    const handleAddManualPayment = async (e: React.FormEvent) => {
        e.preventDefault();
        if (!newAmount || Number(newAmount) <= 0 || !supabaseBrowser) return;

        setIsSubmitting(true);
        console.log("🚀 [AddPayment] Starting manual payment registration via API...");
        try {
            // Get session for auth header
            const { data: { session } } = await supabaseBrowser.auth.getSession();
            if (!session) throw new Error("Sessão expirada. Faz login novamente.");

            const response = await fetch('/api/admin/payments/register', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${session.access_token}`
                },
                body: JSON.stringify({
                    bookingId,
                    amount: Number(newAmount),
                    method: newMethod === 'cash' ? 'manual' : newMethod,
                    notes: newNote,
                    label: newLabel,
                    verifiedAt: new Date().toISOString()
                })
            });

            const result = await response.json();

            if (!response.ok) {
                console.error("❌ [AddPayment] API Error:", result.error);
                throw new Error(result.error || "Erro ao registar pagamento");
            }

            console.log("✅ [AddPayment] Payment registered successfully:", result);

            setShowAddForm(false);
            setNewAmount('');
            setNewNote('');
            setNewLabel('');

            console.log("🔄 [AddPayment] refreshing local state...");
            await fetchPayments();
            console.log("📣 [AddPayment] informing parent component...");
            onUpdate();
            console.log("✨ [AddPayment] Finished!");
        } catch (err: any) {
            console.error("🚨 [AddPayment] CRITICAL ERROR:", err);
            alert("Erro ao adicionar: " + err.message);
        } finally {
            console.log("🏁 [AddPayment] isSubmitting set to false");
            setIsSubmitting(false);
        }
    };

    const handleVerify = async (paymentId: string, amount: number) => {
        if (!confirm("Validar este comprovativo?")) return;
        if (!supabaseBrowser) {
            alert("Erro: Supabase não inicializado.");
            return;
        }

        const url = '/api/admin/payments/verify';

        try {
            // Get session for auth header
            const { data: { session } } = await supabaseBrowser.auth.getSession();
            if (!session) throw new Error("Sessão expirada. Faz login novamente.");

            const payload = { paymentId, bookingId };

            console.log("🔵 [Verify] Sending request to:", url);
            console.log("📦 [Verify] Payload:", payload);

            const res = await fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${session.access_token}`
                },
                body: JSON.stringify(payload)
            });

            console.log("📡 [Verify] Response status:", res.status, res.statusText);
            console.log("📡 [Verify] Response URL:", res.url);

            if (!res.ok) {
                const errorText = await res.text();
                console.error("❌ [Verify] Error response:", errorText);
                throw new Error("Erro ao validar");
            }

            const data = await res.json();
            console.log("✅ [Verify] Success:", data);

            onUpdate(); // Trigger parent to refresh
            onUpdate();
        } catch (e: any) {
            console.error("🚨 [Verify] Catch block:", e);
            alert(e.message);
        }
    };

    const handleEditPayment = async (paymentId: string) => {
        if (!supabaseBrowser) return;
        if (!editForm.amount || Number(editForm.amount) <= 0) {
            alert("Valor inválido");
            return;
        }

        if (!confirm("Confirmar alteração do pagamento?")) return;

        setIsSubmitting(true);
        try {
            // Get old payment
            const oldPayment = propsPayments.find(p => p.id === paymentId);
            if (!oldPayment) throw new Error("Pagamento não encontrado");

            const diff = Number(editForm.amount) - oldPayment.amount;

            // Get current user
            const { data: { user } } = await supabaseBrowser.auth.getUser();

            // Update payment
            const { error: updateError } = await supabaseBrowser
                .from('pilgrimage_payments')
                .update({
                    amount: Number(editForm.amount),
                    method: editForm.method,
                    notes: editForm.notes,
                    edit_history: [
                        ...(oldPayment.edit_history || []),
                        {
                            edited_at: new Date().toISOString(),
                            old_amount: oldPayment.amount,
                            new_amount: Number(editForm.amount),
                            edited_by: user?.id
                        }
                    ]
                })
                .eq('id', paymentId);

            if (updateError) throw updateError;

            // Update booking paid_amount
            const { data: currentBooking } = await supabaseBrowser
                .from('bookings')
                .select('paid_amount')
                .eq('id', bookingId)
                .single();

            const updatedPaid = (currentBooking?.paid_amount || 0) + diff;
            await supabaseBrowser
                .from('bookings')
                .update({ paid_amount: updatedPaid })
                .eq('id', bookingId);

            setEditingPaymentId(null);
            onUpdate(); // Trigger parent to refresh
            onUpdate();
        } catch (err: any) {
            alert("Erro ao editar: " + err.message);
        } finally {
            setIsSubmitting(false);
        }
    };

    const handleDeletePayment = async (paymentId: string, amount: number) => {
        if (!confirm("🚨 ATENÇÃO: Isto vai REVERTER este pagamento e subtrair o valor do total pago. Tens a certeza?")) return;

        setIsSubmitting(true);
        try {
            const { data: { user } } = await supabaseBrowser.auth.getUser();

            // Soft delete
            const { error: deleteError } = await supabaseBrowser
                .from('pilgrimage_payments')
                .update({
                    deleted: true,
                    deleted_at: new Date().toISOString(),
                    deleted_by: user?.id
                })
                .eq('id', paymentId);

            if (deleteError) throw deleteError;

            // Subtract from paid_amount
            const { data: currentBooking } = await supabaseBrowser
                .from('bookings')
                .select('paid_amount')
                .eq('id', bookingId)
                .single();

            const updatedPaid = Math.max(0, (currentBooking?.paid_amount || 0) - amount);
            await supabaseBrowser
                .from('bookings')
                .update({ paid_amount: updatedPaid })
                .eq('id', bookingId);

            onUpdate(); // Trigger parent to refresh
            onUpdate();
        } catch (err: any) {
            alert("Erro ao eliminar: " + err.message);
        } finally {
            setIsSubmitting(false);
        }
    };

    const startEditing = (payment: Payment) => {
        setEditingPaymentId(payment.id);
        setEditForm({
            amount: payment.amount.toString(),
            method: payment.method,
            notes: payment.notes || ''
        });
    };

    const cancelEditing = () => {
        setEditingPaymentId(null);
        setEditForm({ amount: '', method: '', notes: '' });
    };

    const remaining = Math.max(0, totalAmount - paidAmount);

    return (
        <div className="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm">
            {/* Header / Summary */}
            <div className="bg-slate-50 p-6 border-b border-slate-200">
                <div className="flex justify-between items-center mb-6">
                    <div>
                        <h3 className="text-lg font-bold text-slate-900">Gestão Financeira</h3>
                        <p className="text-sm text-slate-500">Histórico de pagamentos e acertos manuais.</p>
                    </div>
                    <button
                        onClick={() => setShowAddForm(!showAddForm)}
                        className="flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-xl text-sm font-bold transition-all"
                    >
                        <Plus className="w-4 h-4" /> Registar Pagamento
                    </button>
                </div>

                <div className="grid grid-cols-3 gap-4">
                    <div className="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                        <p className="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Total da Reserva</p>
                        <p className="text-xl font-bold text-slate-900">{totalAmount}€</p>
                    </div>
                    <div className="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                        <p className="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Total Pago</p>
                        <p className="text-xl font-bold text-green-600">{paidAmount}€</p>
                    </div>
                    <div className="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                        <p className="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Em Dívida</p>
                        <p className="text-xl font-bold text-red-600">{remaining}€</p>
                    </div>
                </div>
            </div>

            {/* Installment Status Section (Admin View) */}
            {paymentPlan && paymentPlan.length > 0 && (
                <div className="bg-gradient-to-r from-indigo-50 to-purple-50 p-6 border-b border-indigo-100">
                    <h4 className="text-sm font-bold text-indigo-900 mb-4 flex items-center gap-2">
                        📊 Estado das Prestações
                    </h4>
                    <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
                        {installments.map((inst: InstallmentStatus, idx: number) => (
                            <div
                                key={idx}
                                className={`p-3 rounded-xl border-2 ${inst.status === 'paid' ? 'bg-green-50 border-green-200' :
                                    inst.status === 'partial' ? 'bg-amber-50 border-amber-200' :
                                        'bg-slate-50 border-slate-200'
                                    }`}
                            >
                                <div className="flex items-center justify-between mb-2">
                                    <span className="text-xs font-bold text-slate-700">{inst.label}</span>
                                    <span className="text-[10px] font-bold px-2 py-0.5 rounded-full ${
                                        inst.status === 'paid' ? 'bg-green-100 text-green-700' :
                                        inst.status === 'partial' ? 'bg-amber-100 text-amber-700' :
                                        'bg-slate-100 text-slate-500'
                                    }">
                                        {inst.status === 'paid' && '✅ PAGO'}
                                        {inst.status === 'partial' && '⚠️ PARCIAL'}
                                        {inst.status === 'pending' && '⏳ PENDENTE'}
                                    </span>
                                </div>
                                <div className="flex items-baseline gap-1 mb-1">
                                    <span className="text-lg font-bold ${
                                        inst.status === 'paid' ? 'text-green-700' :
                                        inst.status === 'partial' ? 'text-amber-700' :
                                        'text-slate-500'
                                    }">
                                        {inst.paidAmount.toFixed(0)}€
                                    </span>
                                    <span className="text-xs text-slate-500">/ {inst.expectedAmount.toFixed(0)}€</span>
                                </div>
                                {inst.remainingAmount > 0 && (
                                    <p className="text-xs font-bold text-red-600">
                                        Falta: {inst.remainingAmount.toFixed(2)}€
                                    </p>
                                )}
                                {inst.payments.length > 0 && (
                                    <p className="text-[10px] text-slate-500 mt-1">
                                        {inst.payments.length} pag{inst.payments.length > 1 ? 's' : ''}
                                    </p>
                                )}
                            </div>
                        ))}
                    </div>
                </div>
            )}
            {showAddForm && (
                <div className="p-6 bg-indigo-50 border-b border-indigo-100 animate-in slide-in-from-top-4 duration-300">
                    <form onSubmit={handleAddManualPayment} className="grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
                        <div className="space-y-1">
                            <label className="text-xs font-bold text-indigo-900 uppercase">Valor (€)</label>
                            <input
                                type="number"
                                value={newAmount}
                                onChange={(e) => setNewAmount(e.target.value)}
                                className="w-full bg-white border border-indigo-200 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none"
                                placeholder="ex: 500"
                                required
                            />
                        </div>
                        <div className="space-y-1">
                            <label className="text-xs font-bold text-indigo-900 uppercase">Método</label>
                            <select
                                value={newMethod}
                                onChange={(e) => setNewMethod(e.target.value)}
                                className="w-full bg-white border border-indigo-200 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none"
                            >
                                <option value="bank_transfer">Transferência</option>
                                <option value="cash">Numerário / Dinheiro</option>
                                <option value="mbway">MBWAY</option>
                                <option value="manual">Outro</option>
                            </select>
                        </div>
                        <div className="space-y-1">
                            <label className="text-xs font-bold text-indigo-900 uppercase">Referente a</label>
                            <select
                                value={newLabel}
                                onChange={(e) => setNewLabel(e.target.value)}
                                className="w-full bg-white border border-indigo-200 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none"
                            >
                                <option value="">Pagamento Geral (Saldo)</option>
                                <option value="Sinal">Sinal de Reserva</option>
                                {parsedPaymentPlan.map((step: any, i: number) => (
                                    <option key={i} value={`Prestação ${i + 1}`}>Prestação {i + 1} ({format(new Date(step.date), "MMM", { locale: pt })})</option>
                                ))}
                            </select>
                        </div>
                        <div className="space-y-1">
                            <label className="text-xs font-bold text-indigo-900 uppercase">Nota Adicional</label>
                            <input
                                type="text"
                                value={newNote}
                                onChange={(e) => setNewNote(e.target.value)}
                                className="w-full bg-white border border-indigo-200 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none"
                                placeholder="..."
                            />
                        </div>
                        <div className="flex gap-2">
                            <button
                                type="submit"
                                disabled={isSubmitting}
                                className="flex-1 bg-indigo-600 text-white py-2 rounded-lg text-sm font-bold hover:bg-indigo-700 disabled:opacity-50"
                            >
                                {isSubmitting ? '...' : 'Confirmar'}
                            </button>
                            <button
                                type="button"
                                onClick={() => setShowAddForm(false)}
                                className="px-3 py-2 bg-white border border-indigo-200 text-indigo-600 rounded-lg hover:bg-white/50"
                            >
                                <X className="w-4 h-4" />
                            </button>
                        </div>
                    </form>
                </div>
            )
            }

            {/* Payments List */}
            <div className="divide-y divide-slate-100">
                {propsPayments.length === 0 ? (
                    <div className="p-10 text-center text-slate-400 text-sm italic">
                        Nenhum registo de pagamento encontrado.
                    </div>
                ) : (
                    propsPayments.map((p) => (
                        <div key={p.id} className="p-4 hover:bg-slate-50 transition-colors">
                            {editingPaymentId === p.id ? (
                                <div className="space-y-3">
                                    <div className="grid grid-cols-3 gap-3">
                                        <div>
                                            <label className="text-xs font-bold text-slate-500 uppercase mb-1 block">Valor (€)</label>
                                            <input
                                                type="number"
                                                value={editForm.amount}
                                                onChange={(e) => setEditForm({ ...editForm, amount: e.target.value })}
                                                className="w-full bg-slate-50 border border-slate-200 rounded-lg p-2 text-sm focus:border-indigo-500 outline-none"
                                            />
                                        </div>
                                        <div>
                                            <label className="text-xs font-bold text-slate-500 uppercase mb-1 block">Método</label>
                                            <select
                                                value={editForm.method}
                                                onChange={(e) => setEditForm({ ...editForm, method: e.target.value })}
                                                className="w-full bg-slate-50 border border-slate-200 rounded-lg p-2 text-sm focus:border-indigo-500 outline-none"
                                            >
                                                <option value="bank_transfer">Transferência</option>
                                                <option value="cash">Dinheiro</option>
                                                <option value="mbway">MBWAY</option>
                                                <option value="manual">Outro</option>
                                            </select>
                                        </div>
                                        <div>
                                            <label className="text-xs font-bold text-slate-500 uppercase mb-1 block">Nota</label>
                                            <input
                                                type="text"
                                                value={editForm.notes}
                                                onChange={(e) => setEditForm({ ...editForm, notes: e.target.value })}
                                                className="w-full bg-slate-50 border border-slate-200 rounded-lg p-2 text-sm focus:border-indigo-500 outline-none"
                                            />
                                        </div>
                                    </div>
                                    <div className="flex gap-2 justify-end">
                                        <button
                                            onClick={cancelEditing}
                                            className="px-3 py-1.5 bg-slate-100 text-slate-600 rounded-lg text-xs font-bold hover:bg-slate-200"
                                        >
                                            Cancelar
                                        </button>
                                        <button
                                            onClick={() => handleEditPayment(p.id)}
                                            disabled={isSubmitting}
                                            className="px-3 py-1.5 bg-indigo-600 text-white rounded-lg text-xs font-bold hover:bg-indigo-700 disabled:opacity-50"
                                        >
                                            💾 Guardar
                                        </button>
                                    </div>
                                </div>
                            ) : (
                                <div className="flex items-center justify-between">
                                    <div className="flex items-center gap-4">
                                        <div className={`w-10 h-10 rounded-xl flex items-center justify-center ${p.status === 'verified' || p.status === 'succeeded' ? 'bg-green-100 text-green-600' :
                                            p.status === 'verifying' ? 'bg-amber-100 text-amber-600' : 'bg-slate-100 text-slate-400'
                                            }`}>
                                            {p.status === 'verified' || p.status === 'succeeded' ? <Check className="w-5 h-5" /> :
                                                p.status === 'verifying' ? <Clock className="w-5 h-5 animate-pulse" /> : <AlertCircle className="w-5 h-5" />}
                                        </div>
                                        <div>
                                            <div className="flex items-center gap-2">
                                                <span className="font-bold text-slate-900">{p.amount}€</span>
                                                <span className="text-[10px] px-1.5 py-0.5 bg-slate-100 text-slate-500 rounded font-bold uppercase">{p.method}</span>
                                                {p.edit_history && p.edit_history.length > 0 && (
                                                    <span className="text-[10px] px-1.5 py-0.5 bg-amber-100 text-amber-600 rounded font-bold" title={`Editado ${p.edit_history.length}x`}>
                                                        ✏️ EDITADO
                                                    </span>
                                                )}
                                            </div>
                                            <div className="text-xs text-slate-500 flex items-center gap-2">
                                                <span>{format(new Date(p.created_at), 'dd MMM yyyy HH:mm', { locale: pt })}</span>
                                                {p.notes && <span className="text-slate-300">•</span>}
                                                {p.notes && <span className="italic">{p.notes}</span>}
                                            </div>
                                        </div>
                                    </div>

                                    <div className="flex items-center gap-2">
                                        {p.receipt_url && (
                                            <a
                                                href={p.receipt_url}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                className="text-xs font-bold text-indigo-600 hover:text-indigo-800 flex items-center gap-1 bg-indigo-50 px-2 py-1 rounded"
                                            >
                                                <FileText className="w-3 h-3" /> Talão
                                            </a>
                                        )}

                                        {p.status === 'verifying' && (
                                            <button
                                                onClick={() => handleVerify(p.id, p.amount)}
                                                className="bg-green-600 hover:bg-green-700 text-white text-[10px] font-bold px-3 py-1.5 rounded-lg shadow-sm transition-all flex items-center gap-1"
                                            >
                                                <Check className="w-3 h-3" /> Validar
                                            </button>
                                        )}

                                        {/* Only allow editing/deleting manual payments */}
                                        {(p.method === 'manual' || p.method === 'bank_transfer' || p.method === 'cash' || p.method === 'mbway') && p.status === 'verified' && (
                                            <>
                                                <button
                                                    onClick={() => startEditing(p)}
                                                    className="text-xs font-bold text-slate-600 hover:text-indigo-600 flex items-center gap-1 bg-slate-100 hover:bg-indigo-50 px-2 py-1 rounded transition-colors"
                                                    title="Editar pagamento"
                                                >
                                                    ✏️ Editar
                                                </button>
                                                <button
                                                    onClick={() => handleDeletePayment(p.id, p.amount)}
                                                    disabled={isSubmitting}
                                                    className="text-xs font-bold text-red-600 hover:text-red-800 flex items-center gap-1 bg-red-50 hover:bg-red-100 px-2 py-1 rounded transition-colors disabled:opacity-50"
                                                    title="Eliminar pagamento"
                                                >
                                                    <Trash2 className="w-3 h-3" /> Eliminar
                                                </button>
                                            </>
                                        )}
                                    </div>
                                </div>
                            )}
                        </div>
                    ))
                )}
            </div>

            {/* Payment Plan Timeline (Admin View) */}
            {
                paymentPlan.length > 0 && (
                    <div className="bg-slate-50/50 p-6 border-t border-slate-100">
                        <h4 className="text-xs font-bold text-slate-400 uppercase tracking-widest mb-4">Plano de Prestações</h4>
                        <div className="space-y-3">
                            {paymentPlan.map((step, idx) => {
                                const stepAmount = Number(step.amount);
                                // Simple heuristic to see if this installment is paid
                                // We use the cumulative approach again
                                const depositRef = propDepositValue || (totalAmount * 0.2); // This is a fallback if we don't have it, but we should pass it
                                // For simplicity, let's just show it as a guide for now
                                return (
                                    <div key={idx} className="flex items-center justify-between bg-white p-3 rounded-xl border border-slate-200 text-sm">
                                        <div className="flex items-center gap-3">
                                            <Calendar className="w-4 h-4 text-slate-400" />
                                            <span className="font-medium text-slate-700">Prestação {idx + 1}</span>
                                            <span className="text-slate-400">•</span>
                                            <span className="text-slate-500">{format(new Date(step.date), "dd/MM/yyyy")}</span>
                                        </div>
                                        <span className="font-bold text-slate-900">{stepAmount}€</span>
                                    </div>
                                );
                            })}
                        </div>
                    </div>
                )
            }
        </div >
    );
}
