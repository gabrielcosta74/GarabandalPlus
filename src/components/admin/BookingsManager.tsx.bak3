"use client";

import { useEffect, useState } from 'react';
import { supabaseBrowser } from '../../lib/supabase-browser';
import AdminTable from './AdminTable';
import { Download, Mail, Phone, AlertCircle, FileText, Settings, X, CreditCard, User, Bed, Plane, Heart, MoreVertical, Search, Filter, Calendar, MapPin, Shield, Info, ClipboardList, Users, Edit2, Save as SaveIcon } from 'lucide-react';
import { format } from 'date-fns';
import { pt } from 'date-fns/locale';
import { toast } from 'sonner';
import { parseRoomInfo } from '../../lib/utils';

const DetailItem = ({ label, value, capitalize = false }: { label: string; value?: string | number | null; capitalize?: boolean }) => (
    <div className="space-y-1">
        <p className="text-[10px] font-bold text-slate-400 uppercase tracking-wider">{label}</p>
        <p className={`text-sm font-bold text-slate-700 ${capitalize ? 'capitalize' : ''}`}>
            {value || '-'}
        </p>
    </div>
);
import PaymentHistoryManager from './PaymentHistoryManager';
import PaymentStatusBadge from './PaymentStatusBadge';

interface Pilgrim {
    id: string;
    booking_id: string;
    full_name: string;
    email?: string;
    phone?: string;
    flight_option?: string;
    room_type?: string;
    allergies?: string;
    dietary_restrictions?: string;
    health_notes?: string;
    birth_date?: string;
    sex?: string;
    address?: string;
    postal_code?: string;
    city?: string;
    country?: string;
    whatsapp?: string;
    notes?: string;
    cpf_nif?: string;
    bed_preference?: string;
    sharing_mode?: string;
    roommate_name?: string;
}

interface Booking {
    id: string;
    status: string;
    created_at: string;
    paid_amount: number;
    total_amount: number;
    payment_plan: any[];
    pilgrims: Pilgrim[];
    verifying_payment?: {
        id: string;
        receipt_url?: string;
        status: string;
    };
}

export default function BookingsManager({ pilgrimageId }: { pilgrimageId: string }) {
    const [bookings, setBookings] = useState<Booking[]>([]);
    const [loading, setLoading] = useState(true);
    const [selectedBooking, setSelectedBooking] = useState<Booking | null>(null);
    const [viewDetailPilgrim, setViewDetailPilgrim] = useState<{ booking: Booking, pilgrim: Pilgrim } | null>(null);
    const [activeDetailTab, setActiveDetailTab] = useState<'personal' | 'logistics' | 'finance'>('personal');

    const inputDateValue = (dateStr?: string | null) => {
        if (!dateStr) return '';
        try {
            return new Date(dateStr).toISOString().split('T')[0];
        } catch (e) {
            return '';
        }
    };

    // Edit State
    const [editingPilgrimId, setEditingPilgrimId] = useState<string | null>(null);
    const [editForm, setEditForm] = useState<Partial<Pilgrim>>({});

    const startEditing = (pilgrim: Pilgrim) => {
        setEditingPilgrimId(pilgrim.id);
        setEditForm(pilgrim);
    };

    const cancelEditing = () => {
        setEditingPilgrimId(null);
        setEditForm({});
    };

    const savePilgrim = async () => {
        if (!supabaseBrowser || !editingPilgrimId) return;

        try {
            const { error } = await supabaseBrowser
                .from('pilgrims')
                .update({
                    full_name: editForm.full_name,
                    email: editForm.email,
                    phone: editForm.phone,
                    birth_date: editForm.birth_date,
                    flight_option: editForm.flight_option,
                    room_type: editForm.room_type,
                    bed_preference: editForm.bed_preference,
                    sharing_mode: editForm.sharing_mode,
                    roommate_name: editForm.roommate_name,
                    notes: editForm.notes,
                    // Add other fields as needed
                })
                .eq('id', editingPilgrimId);

            if (error) throw error;

            toast.success('Peregrino atualizado com sucesso!');
            setEditingPilgrimId(null);
            fetchBookings();
        } catch (e: any) {
            toast.error('Erro ao atualizar: ' + e.message);
        }
    };

    const updateBookingStatus = async (newStatus: string) => {
        if (!selectedBooking || !supabaseBrowser) return;
        if (!confirm('Tem a certeza que deseja alterar o estado da reserva?')) return;

        try {
            const { error } = await supabaseBrowser
                .from('bookings')
                .update({ status: newStatus })
                .eq('id', selectedBooking.id);

            if (error) throw error;
            toast.success(`Estado alterado para ${newStatus}`);

            // Update local state
            setSelectedBooking(prev => prev ? { ...prev, status: newStatus } : null);
            fetchBookings();
        } catch (e: any) {
            toast.error('Erro ao alterar estado: ' + e.message);
        }
    };

    const migrateLegacyData = async () => {
        if (!confirm('⚠️ AVISO DE ADMIN\n\nIsto vai percorrer TODOS os peregrinos e tentar extrair a informação das "Notas" (ex: [Pref. Cama: ...]) para as novas colunas organizadas.\n\nContinuar?')) return;

        setLoading(true);
        let updatedCount = 0;

        try {
            // Fetch all pilgrims for this pilgrimage to ensure we have the latest notes
            // We need to fetch ALL pilgrims, not just from the bookings in memory to be safe, 
            // but effectively we only care about those linked to displayed bookings.
            // Let's iterate over the currently loaded bookings to be safer and scoped.

            const allPilgrims = bookings.flatMap(b => b.pilgrims);

            for (const p of allPilgrims) {
                // Parse info
                const info = parseRoomInfo(p.notes);

                // Only update if we found something AND if columns are empty (to not overwrite manual edits)
                if ((info.bedType || info.sharingMode || info.roommates) &&
                    (!p.bed_preference && !p.sharing_mode)) {

                    const updates: any = {};
                    if (info.bedType) {
                        // Map to enum/values
                        // 'Twin' -> 'twin_beds', 'Casal' -> 'double_bed', etc.
                        // For now keeping raw string or doing basic mapping? 
                        // Let's try to map to our select values if possible, otherwise keep raw
                        const type = info.bedType.toLowerCase();
                        if (type.includes('twin') || type.includes('duas')) updates.bed_preference = 'twin_beds';
                        else if (type.includes('casal') || type.includes('duplo')) updates.bed_preference = 'double_bed';
                        else if (type.includes('single') || type.includes('uma')) updates.bed_preference = 'single_bed';
                        else updates.bed_preference = info.bedType;
                    }

                    if (info.sharingMode) {
                        const mode = info.sharingMode.toLowerCase();
                        if (mode.includes('aleat') || mode.includes('random')) updates.sharing_mode = 'random';
                        else if (mode.includes('parceiro') || mode.includes('conjunto')) updates.sharing_mode = 'partner';
                        else updates.sharing_mode = info.sharingMode;
                    }

                    if (info.roommates) updates.roommate_name = info.roommates;

                    if (Object.keys(updates).length > 0) {
                        await supabaseBrowser
                            .from('pilgrims')
                            .update(updates)
                            .eq('id', p.id);
                        updatedCount++;
                    }
                }
            }

            toast.success(`Migração concluída! ${updatedCount} registos atualizados.`);
            fetchBookings(); // Refresh UI

        } catch (e: any) {
            console.error("Migration error:", e);
            toast.error('Erro na migração: ' + e.message);
            setLoading(false);
        }
    };

    const fetchBookings = async () => {
        if (!supabaseBrowser) {
            console.error("Supabase client not initialized");
            setLoading(false);
            return;
        }
        setLoading(true);
        try {
            const { data, error } = await supabaseBrowser
                .from('bookings')
                .select(`
                    id,
                    status,
                    created_at,
                    paid_amount,
                    total_amount,
                    payment_plan,
                    pilgrims (
                        id,
                        full_name,
                        email,
                        phone,
                        flight_option,
                        room_type,
                        allergies,
                        dietary_restrictions,
                        health_notes,
                        birth_date,
                        sex,
                        address,
                        postal_code,
                        city,
                        country,
                        notes,
                        cpf_nif,
                        bed_preference,
                        sharing_mode,
                        roommate_name
                    ),
                    payments: pilgrimage_payments (
                        id,
                        receipt_url,
                        status
                    )
                `)
                .eq('pilgrimage_id', pilgrimageId)
                .order('created_at', { ascending: false });

            if (error) throw error;

            if (data) {
                const bookingsList: Booking[] = data.map((booking: any) => {
                    const verifyingPayment = booking.payments?.find((pay: any) => pay.status === 'verifying');

                    return {
                        id: booking.id,
                        status: booking.status,
                        created_at: booking.created_at,
                        paid_amount: booking.paid_amount || 0,
                        total_amount: booking.total_amount || 0,
                        payment_plan: booking.payment_plan || [],
                        pilgrims: booking.pilgrims || [],
                        verifying_payment: verifyingPayment
                    };
                });

                setBookings(bookingsList);

                if (selectedBooking) {
                    const updated = bookingsList.find(b => b.id === selectedBooking.id);
                    if (updated) setSelectedBooking(updated);
                }
            }
        } catch (err) {
            console.error("Error fetching bookings:", err);
        } finally {
            setLoading(false);
        }
    };

    useEffect(() => {
        if (pilgrimageId) fetchBookings();
    }, [pilgrimageId]);

    const handleExport = () => {
        if (!bookings.length) return;

        const headers = ["Ref Reserva", "Data", "Peregrino", "Email", "Telemóvel", "Quarto", "Cama Pref.", "Modo Partilha", "Com Quem", "Voo", "Total Pago", "Total Devido", "Alergias", "Notas"];
        const csvRows = [headers.join(";")];

        bookings.forEach(booking => {
            const bookingRef = booking.id.slice(0, 8);
            const dateStr = format(new Date(booking.created_at), 'dd/MM/yyyy');

            booking.pilgrims.forEach(p => {
                // Determine display values (column takes precedence, fallback to notes parse)
                const legacyInfo = parseRoomInfo(p.notes);
                const bed = p.bed_preference || legacyInfo.bedType || "";
                const sharing = p.sharing_mode || legacyInfo.sharingMode || "";
                const roommate = p.roommate_name || legacyInfo.roommates || "";

                csvRows.push([
                    bookingRef,
                    dateStr,
                    p.full_name,
                    p.email || "",
                    p.phone || "",
                    p.room_type || "",
                    bed,
                    sharing,
                    roommate,
                    p.flight_option || "",
                    booking.paid_amount.toFixed(2),
                    booking.total_amount.toFixed(2),
                    (p.allergies || "").replace(/;/g, ","),
                    (p.notes || "").replace(/;/g, ",")
                ].join(";"));
            });
        });

        const blob = new Blob(["\ufeff" + csvRows.join("\n")], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement("a");
        link.setAttribute("href", url);
        link.setAttribute("download", `inscricoes_${pilgrimageId.slice(0, 5)}.csv`);
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    };

    const getFlightLabel = (option?: string) => {
        if (!option) return '-';
        const labels: Record<string, string> = {
            'none': 'Sem Voo',
            'own': 'Voo Próprio',
            'group': 'Voo de Grupo'
        };
        return labels[option] || option;
    };



    const totalPilgrims = bookings.reduce((sum, b) => sum + b.pilgrims.length, 0);
    const totalRevenue = bookings.reduce((sum, b) => sum + b.paid_amount, 0);
    const totalPending = bookings.reduce((sum, b) => sum + Math.max(0, b.total_amount - b.paid_amount), 0);
    const verifyingCount = bookings.filter(b => b.verifying_payment).length;

    const columns = [
        {
            key: 'booking_ref',
            header: 'Reserva',
            sortable: true,
            render: (row: Booking) => (
                <div className="flex items-center gap-3">
                    <div className="w-9 h-9 bg-indigo-100 rounded-full flex items-center justify-center text-indigo-700 shrink-0">
                        <Users className="w-5 h-5" />
                    </div>
                    <div>
                        <div className="font-bold text-slate-900 leading-tight">REF #{row.id.slice(0, 8).toUpperCase()}</div>
                        <div className="text-[10px] text-slate-400 mt-0.5 flex items-center gap-1.5">
                            <Users className="w-3 h-3" />
                            <span>{row.pilgrims.length} {row.pilgrims.length === 1 ? 'peregrino' : 'peregrinos'}</span>
                            <span>•</span>
                            <span>{format(new Date(row.created_at), 'dd/MM/yy')}</span>
                        </div>
                    </div>
                </div>
            )
        },
        {
            key: 'pilgrims',
            header: 'Peregrinos',
            render: (row: Booking) => (
                <div className="flex flex-col gap-1 max-w-xs">
                    {row.pilgrims.slice(0, 2).map((p, idx) => (
                        <div key={p.id} className="text-xs text-slate-600 flex items-center gap-1.5">
                            <User className="w-3 h-3 text-slate-400" />
                            <span className="font-medium truncate">{p.full_name}</span>
                        </div>
                    ))}
                    {row.pilgrims.length > 2 && (
                        <div className="text-[10px] text-indigo-600 font-bold">
                            +{row.pilgrims.length - 2} mais
                        </div>
                    )}
                </div>
            )
        },
        {
            key: 'payment_progress',
            header: 'Pagamento',
            render: (row: Booking) => {
                const percent = row.total_amount > 0 ? Math.round((row.paid_amount / row.total_amount) * 100) : 0;
                const remaining = Math.max(0, row.total_amount - row.paid_amount);

                return (
                    <div className="flex flex-col gap-1 min-w-[140px]">
                        <div className="flex justify-between items-end text-[11px]">
                            <span className="font-bold text-slate-700">{row.paid_amount.toFixed(2)}€</span>
                            <span className={remaining > 0 ? 'text-red-500 font-bold' : 'text-emerald-600 font-bold'}>
                                {remaining > 0 ? `-${remaining.toFixed(2)}€` : 'Liquidado'}
                            </span>
                        </div>
                        <div className="w-full h-1.5 bg-slate-100 rounded-full overflow-hidden">
                            <div
                                className={`h-full transition-all duration-700 ${percent >= 100 ? 'bg-emerald-500' : 'bg-indigo-500'}`}
                                style={{ width: `${Math.min(100, percent)}%` }}
                            />
                        </div>
                        <div className="text-[10px] text-slate-400 text-right">
                            Total: {row.total_amount.toFixed(2)}€
                        </div>
                    </div>
                );
            }
        },
        {
            key: 'actions',
            header: '',
            render: (row: Booking) => (
                <button
                    onClick={() => setSelectedBooking(row)}
                    className="p-2 hover:bg-slate-100/80 rounded-full text-slate-400 hover:text-indigo-600 transition-all active:scale-95 group relative"
                >
                    <Info className="w-4 h-4" />
                    <span className="absolute right-full mr-2 top-1/2 -translate-y-1/2 bg-slate-900 text-white text-[10px] px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none">
                        Ver Detalhes Completos
                    </span>
                </button>
            )
        }
    ];

    return (
        <div className="space-y-6 animate-in fade-in slide-in-from-bottom-4 duration-500">
            <div className="bg-white p-8 rounded-3xl border border-slate-200 shadow-xl shadow-slate-200/50">
                <div className="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-6 mb-8">
                    <div>
                        <div className="flex items-center gap-3 mb-1">
                            <div className="w-2 h-8 bg-indigo-600 rounded-full" />
                            <h3 className="text-2xl font-bold font-serif text-slate-900 tracking-tight">Painel de Inscrições</h3>
                        </div>
                        <p className="text-slate-500 text-sm ml-5">Controlo logístico e financeiro em tempo real da peregrinação.</p>
                    </div>
                    <div className="flex items-center gap-3 w-full lg:w-auto">
                        <button
                            onClick={handleExport}
                            className="flex-1 lg:flex-none flex items-center justify-center gap-2 text-sm font-bold text-slate-700 bg-white border-2 border-slate-100 px-5 py-3 rounded-2xl hover:bg-slate-50 hover:border-slate-200 transition-all shadow-sm"
                        >
                            <Download className="w-4 h-4 text-indigo-600" /> Exportar Dados (CSV)
                        </button>
                        <button
                            onClick={migrateLegacyData}
                            className="flex items-center justify-center gap-2 text-xs font-bold text-amber-700 bg-amber-50 border-2 border-amber-100 px-4 py-3 rounded-2xl hover:bg-amber-100 hover:border-amber-200 transition-all shadow-sm"
                            title="Migrar dados das Notas para Colunas"
                        >
                            <Settings className="w-4 h-4" /> Migrar Dados Antigos
                        </button>
                    </div>
                </div>

                <div className="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-6">
                    <div className="bg-gradient-to-br from-indigo-500 to-indigo-600 p-6 rounded-3xl text-white shadow-lg shadow-indigo-200 flex flex-col justify-between min-h-[140px] relative overflow-hidden group">
                        <div className="absolute -right-4 -bottom-4 opacity-10 group-hover:scale-110 transition-transform duration-500">
                            <User className="w-32 h-32" />
                        </div>
                        <p className="text-xs font-bold uppercase tracking-wider opacity-80">Total Inscritos</p>
                        <p className="text-4xl font-bold mt-2">{totalPilgrims}</p>
                        <div className="mt-4 flex items-center gap-2 text-[10px] font-bold bg-white/20 w-fit px-2 py-1 rounded-lg">
                            <Info className="w-3 h-3" /> Atualizado agora
                        </div>
                    </div>

                    <div className="bg-white p-6 rounded-3xl border-2 border-emerald-50 shadow-sm flex flex-col justify-between min-h-[140px] relative overflow-hidden group hover:border-emerald-100 transition-colors">
                        <div className="absolute -right-4 -bottom-4 text-emerald-500/10 group-hover:scale-110 transition-transform duration-500">
                            <CreditCard className="w-32 h-32" />
                        </div>
                        <p className="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Receita Coletada</p>
                        <p className="text-4xl font-bold text-emerald-600 mt-2">
                            {totalRevenue.toFixed(2)}€
                        </p>
                        <div className="mt-4 flex items-center gap-1.5 text-[10px] font-bold text-emerald-600">
                            <div className="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-ping" />
                            Processado Via Stripe/Manual
                        </div>
                    </div>

                    <div className="bg-white p-6 rounded-3xl border-2 border-rose-50 shadow-sm flex flex-col justify-between min-h-[140px] relative overflow-hidden group hover:border-rose-100 transition-colors">
                        <div className="absolute -right-4 -bottom-4 text-rose-500/10 group-hover:scale-110 transition-transform duration-500">
                            <Calendar className="w-32 h-32" />
                        </div>
                        <p className="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Saldos Pendentes</p>
                        <p className="text-4xl font-bold text-rose-500 mt-2">
                            {totalPending.toFixed(2)}€
                        </p>
                        <div className="mt-4 text-[10px] font-bold text-rose-400">
                            Aguardando Prestações
                        </div>
                    </div>

                    <div className="bg-white p-6 rounded-3xl border-2 border-amber-50 shadow-sm flex flex-col justify-between min-h-[140px] relative overflow-hidden group hover:border-amber-100 transition-colors">
                        <div className="absolute -right-4 -bottom-4 text-amber-500/10 group-hover:scale-110 transition-transform duration-500">
                            <Shield className="w-32 h-32" />
                        </div>
                        <p className="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Validações Críticas</p>
                        <p className="text-4xl font-bold text-amber-600 mt-2">
                            {verifyingCount}
                        </p>
                        <div className="mt-4 flex items-center gap-2">
                            <span className="text-[10px] font-bold text-amber-600 bg-amber-50 px-2 py-0.5 rounded-lg border border-amber-100">
                                Ações Necessárias
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <AdminTable
                data={bookings}
                columns={columns}
                isLoading={loading}
                searchPlaceholder="Pesquisar por referência, nome de peregrino..."
                itemsPerPage={20}
                actions={(row) => (
                    <div className="flex items-center gap-2">
                        <button
                            onClick={() => setSelectedBooking(row)}
                            className="flex items-center gap-1.5 text-xs font-bold text-slate-700 bg-white border border-slate-200 px-3 py-2 rounded-lg hover:bg-slate-50 transition-all shadow-sm"
                        >
                            <CreditCard className="w-3.5 h-3.5" /> Gerir Reserva
                        </button>
                    </div>
                )}
            />

            {/* Booking Detail Modal */}
            {selectedBooking && (
                <div className="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 animate-in fade-in duration-300">
                    <div className="bg-slate-50 w-full max-w-4xl max-h-[90vh] rounded-3xl shadow-2xl overflow-hidden flex flex-col animate-in zoom-in-95 duration-300">
                        {/* Modal Header */}
                        <div className="p-6 bg-white border-b border-slate-200 flex justify-between items-center">
                            <div>
                                <h3 className="text-xl font-bold text-slate-900">Detalhes da Reserva</h3>
                                <p className="text-sm text-slate-500">REF: <span className="font-bold text-indigo-600">#{selectedBooking.id.slice(0, 8).toUpperCase()}</span> • {selectedBooking.pilgrims.length} {selectedBooking.pilgrims.length === 1 ? 'peregrino' : 'peregrinos'}</p>
                            </div>
                            <div className="flex items-center gap-3">
                                <select
                                    value={selectedBooking.status}
                                    onChange={(e) => updateBookingStatus(e.target.value)}
                                    className={`text-xs font-bold uppercase py-2 px-3 rounded-lg border outline-none ${selectedBooking.status === 'confirmed' ? 'bg-emerald-50 border-emerald-200 text-emerald-700' :
                                        selectedBooking.status === 'cancelled' ? 'bg-red-50 border-red-200 text-red-700' :
                                            'bg-slate-50 border-slate-200 text-slate-700'
                                        }`}
                                >
                                    <option value="pending">Pendente</option>
                                    <option value="confirmed">Confirmada</option>
                                    <option value="cancelled">Cancelada</option>
                                    <option value="refunded">Reembolsada</option>
                                </select>
                                <button
                                    onClick={() => setSelectedBooking(null)}
                                    className="p-2 hover:bg-slate-100 rounded-full transition-colors"
                                >
                                    <X className="w-6 h-6 text-slate-400" />
                                </button>
                            </div>
                        </div>

                        {/* Modal Content */}
                        <div className="p-6 overflow-y-auto flex-1">
                            {/* Pilgrims List */}
                            <div className="space-y-4">
                                <h4 className="text-lg font-bold text-slate-900 flex items-center gap-2">
                                    <Users className="w-5 h-5 text-indigo-600" />
                                    Peregrinos Inscritos ({selectedBooking.pilgrims.length})
                                </h4>

                                {selectedBooking.pilgrims.map((pilgrim, idx) => {
                                    const roomInfo = parseRoomInfo(pilgrim.notes);

                                    return (

                                        <div key={pilgrim.id} className="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm transition-all hover:border-indigo-100">
                                            {editingPilgrimId === pilgrim.id ? (
                                                <div className="space-y-4">
                                                    <div className="flex justify-between items-center border-b border-slate-100 pb-3">
                                                        <h5 className="font-bold text-indigo-700 flex items-center gap-2">
                                                            <Edit2 className="w-4 h-4" /> A Editar Peregrino
                                                        </h5>
                                                        <div className="flex gap-2">
                                                            <button onClick={cancelEditing} className="p-2 hover:bg-slate-100 rounded-full text-slate-400">
                                                                <X className="w-5 h-5" />
                                                            </button>
                                                            <button onClick={savePilgrim} className="flex items-center gap-2 bg-indigo-600 text-white px-4 py-2 rounded-lg text-xs font-bold hover:bg-indigo-700">
                                                                <SaveIcon className="w-4 h-4" /> Guardar
                                                            </button>
                                                        </div>
                                                    </div>

                                                    <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                                                        <div>
                                                            <label className="block text-xs font-bold text-slate-500 uppercase mb-1">Nome Completo</label>
                                                            <input
                                                                className="w-full bg-slate-50 border border-slate-200 rounded-lg p-2 text-sm focus:border-indigo-500 outline-none"
                                                                value={editForm.full_name || ''}
                                                                onChange={e => setEditForm({ ...editForm, full_name: e.target.value })}
                                                            />
                                                        </div>
                                                        <div>
                                                            <label className="block text-xs font-bold text-slate-500 uppercase mb-1">Data Nascimento</label>
                                                            <input
                                                                type="date"
                                                                className="w-full bg-slate-50 border border-slate-200 rounded-lg p-2 text-sm focus:border-indigo-500 outline-none"
                                                                value={inputDateValue(editForm.birth_date)}
                                                                onChange={e => setEditForm({ ...editForm, birth_date: e.target.value })}
                                                            />
                                                        </div>
                                                        <div>
                                                            <label className="block text-xs font-bold text-slate-500 uppercase mb-1">Email</label>
                                                            <input
                                                                className="w-full bg-slate-50 border border-slate-200 rounded-lg p-2 text-sm focus:border-indigo-500 outline-none"
                                                                value={editForm.email || ''}
                                                                onChange={e => setEditForm({ ...editForm, email: e.target.value })}
                                                            />
                                                        </div>
                                                        <div>
                                                            <label className="block text-xs font-bold text-slate-500 uppercase mb-1">Telemóvel</label>
                                                            <input
                                                                className="w-full bg-slate-50 border border-slate-200 rounded-lg p-2 text-sm focus:border-indigo-500 outline-none"
                                                                value={editForm.phone || ''}
                                                                onChange={e => setEditForm({ ...editForm, phone: e.target.value })}
                                                            />
                                                        </div>
                                                        <div>
                                                            <label className="block text-xs font-bold text-slate-500 uppercase mb-1">Opção de Voo</label>
                                                            <select
                                                                className="w-full bg-slate-50 border border-slate-200 rounded-lg p-2 text-sm focus:border-indigo-500 outline-none"
                                                                value={editForm.flight_option || 'none'}
                                                                onChange={e => setEditForm({ ...editForm, flight_option: e.target.value })}
                                                            >
                                                                <option value="none">1. Não preciso (Vivo na Europa/Outro)</option>
                                                                <option value="own">2. Eu compro as minhas passagens (Voo Próprio)</option>
                                                                <option value="agency">3. Quero comprar pela Agência (Voo Grupo)</option>
                                                            </select>
                                                        </div>
                                                        <div>
                                                            <label className="block text-xs font-bold text-slate-500 uppercase mb-1">Tipo de Quarto</label>
                                                            <select
                                                                className="w-full bg-slate-50 border border-slate-200 rounded-lg p-2 text-sm focus:border-indigo-500 outline-none"
                                                                value={editForm.room_type || 'double'}
                                                                onChange={e => setEditForm({ ...editForm, room_type: e.target.value })}
                                                            >
                                                                <option value="single">Single (Um cama)</option>
                                                                <option value="double">Duplo (Cama Casal / Twin)</option>
                                                                <option value="triple">Triplo</option>
                                                                <option value="quadruple">Quarto Familiar (4)</option>
                                                            </select>
                                                        </div>
                                                    </div>

                                                    {/* Room Preferences (New Fields) */}
                                                    <div className="mt-4 p-4 bg-amber-50 rounded-xl border border-amber-100">
                                                        <h6 className="text-xs font-bold text-amber-800 uppercase mb-3 flex items-center gap-2">
                                                            <Bed className="w-4 h-4" /> Preferências de Quarto
                                                        </h6>
                                                        <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                                                            <div>
                                                                <label className="block text-xs font-bold text-amber-700/70 uppercase mb-1">Cama</label>
                                                                <select
                                                                    className="w-full bg-white border border-amber-200 rounded-lg p-2 text-sm focus:border-amber-500 outline-none"
                                                                    value={editForm.bed_preference || ''}
                                                                    onChange={e => setEditForm({ ...editForm, bed_preference: e.target.value })}
                                                                >
                                                                    <option value="">- Selecionar -</option>
                                                                    <option value="single_bed">Cama Individual</option>
                                                                    <option value="double_bed">Cama Casal (Big Bed)</option>
                                                                    <option value="twin_beds">Duas Camas (Twin)</option>
                                                                </select>
                                                            </div>
                                                            <div>
                                                                <label className="block text-xs font-bold text-amber-700/70 uppercase mb-1">Modo Partilha</label>
                                                                <select
                                                                    className="w-full bg-white border border-amber-200 rounded-lg p-2 text-sm focus:border-amber-500 outline-none"
                                                                    value={editForm.sharing_mode || ''}
                                                                    onChange={e => setEditForm({ ...editForm, sharing_mode: e.target.value })}
                                                                >
                                                                    <option value="">- Selecionar -</option>
                                                                    <option value="random">Aleatório (Com outros)</option>
                                                                    <option value="partner">Com Parceiro Específico</option>
                                                                </select>
                                                            </div>
                                                            <div>
                                                                <label className="block text-xs font-bold text-amber-700/70 uppercase mb-1">Com Quem?</label>
                                                                <input
                                                                    className="w-full bg-white border border-amber-200 rounded-lg p-2 text-sm focus:border-amber-500 outline-none"
                                                                    value={editForm.roommate_name || ''}
                                                                    onChange={e => setEditForm({ ...editForm, roommate_name: e.target.value })}
                                                                    placeholder="Nome do parceiro..."
                                                                />
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div>
                                                        <label className="block text-xs font-bold text-slate-500 uppercase mb-1">Notas (Raw Debug)</label>
                                                        <textarea
                                                            className="w-full bg-slate-50 border border-slate-200 rounded-lg p-2 text-sm focus:border-indigo-500 outline-none font-mono text-xs h-24"
                                                            value={editForm.notes || ''}
                                                            onChange={e => setEditForm({ ...editForm, notes: e.target.value })}
                                                            placeholder="Cuidado ao editar: contém tags [Pref. Cama: ...]"
                                                        />
                                                        <p className="text-[10px] text-amber-600 mt-1 flex items-center gap-1">
                                                            <AlertCircle className="w-3 h-3" />
                                                            Edite com cuidado para não quebrar as tags [Info].
                                                        </p>
                                                    </div>
                                                </div>
                                            ) : (
                                                <>
                                                    <div className="flex justify-between items-start mb-4">
                                                        <div>
                                                            <h5 className="text-lg font-bold text-slate-900">{idx + 1}. {pilgrim.full_name}</h5>
                                                            <div className="flex items-center gap-3 mt-1 text-sm text-slate-500">
                                                                {pilgrim.email && (
                                                                    <a href={`mailto:${pilgrim.email}`} className="flex items-center gap-1 hover:text-indigo-600">
                                                                        <Mail className="w-3 h-3" /> {pilgrim.email}
                                                                    </a>
                                                                )}
                                                                {pilgrim.phone && (
                                                                    <a href={`tel:${pilgrim.phone}`} className="flex items-center gap-1 hover:text-indigo-600">
                                                                        <Phone className="w-3 h-3" /> {pilgrim.phone}
                                                                    </a>
                                                                )}
                                                            </div>
                                                        </div>
                                                        <button
                                                            onClick={() => startEditing(pilgrim)}
                                                            className="p-2 hover:bg-slate-100 rounded-full text-slate-400 hover:text-indigo-600 transition-colors"
                                                            title="Editar Peregrino"
                                                        >
                                                            <Edit2 className="w-4 h-4" />
                                                        </button>
                                                    </div>

                                                    {/* Personal Info */}
                                                    <div className="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
                                                        <DetailItem label="Data Nasc." value={pilgrim.birth_date ? format(new Date(pilgrim.birth_date), 'dd/MM/yyyy') : '-'} />
                                                        <DetailItem label="Sexo" value={pilgrim.sex} capitalize />
                                                        <DetailItem label="Voo" value={getFlightLabel(pilgrim.flight_option)} />
                                                        <DetailItem label="Tipo Quarto" value={pilgrim.room_type} capitalize />
                                                    </div>

                                                    {/* Room Preferences */}
                                                    {(() => {
                                                        const legacyRoomInfo = parseRoomInfo(pilgrim.notes);
                                                        const displayBed = pilgrim.bed_preference || legacyRoomInfo.bedType;
                                                        const displaySharing = pilgrim.sharing_mode || legacyRoomInfo.sharingMode;
                                                        const displayRoommate = pilgrim.roommate_name || legacyRoomInfo.roommates;

                                                        if (!displayBed && !displaySharing && !displayRoommate) return null;

                                                        return (
                                                            <div className="bg-amber-50 p-4 rounded-xl border border-amber-100 mb-4">
                                                                <div className="flex items-center gap-2 mb-3">
                                                                    <Bed className="w-4 h-4 text-amber-700" />
                                                                    <h6 className="text-sm font-bold text-amber-900">Preferências de Quarto</h6>
                                                                </div>
                                                                <div className="grid grid-cols-1 md:grid-cols-3 gap-3">
                                                                    {displayBed && (
                                                                        <div className="bg-white p-3 rounded-lg">
                                                                            <p className="text-[10px] font-bold text-amber-700 uppercase mb-1">Tipo de Cama</p>
                                                                            <p className="text-sm font-bold text-slate-900">{displayBed === 'double_bed' ? 'Cama Casal' : displayBed === 'twin_beds' ? 'Cama Twin' : displayBed === 'single_bed' ? 'Cama Individual' : displayBed}</p>
                                                                        </div>
                                                                    )}
                                                                    {displaySharing && (
                                                                        <div className="bg-white p-3 rounded-lg">
                                                                            <p className="text-[10px] font-bold text-amber-700 uppercase mb-1">Modo de Partilha</p>
                                                                            <p className="text-sm font-bold text-slate-900">{displaySharing === 'random' ? 'Aleatório' : displaySharing === 'partner' ? 'Com Parceiro' : displaySharing}</p>
                                                                        </div>
                                                                    )}
                                                                    {displayRoommate && (
                                                                        <div className="bg-white p-3 rounded-lg">
                                                                            <p className="text-[10px] font-bold text-amber-700 uppercase mb-1">Partilha com</p>
                                                                            <p className="text-sm font-bold text-indigo-600">{displayRoommate}</p>
                                                                        </div>
                                                                    )}
                                                                </div>
                                                            </div>
                                                        );
                                                    })()}

                                                    {/* Health & Notes */}
                                                    {(pilgrim.allergies || roomInfo.cleanNotes) && (
                                                        <div className="space-y-2">
                                                            {pilgrim.allergies && (
                                                                <div className="bg-rose-50 p-3 rounded-xl border border-rose-100">
                                                                    <p className="text-xs font-bold text-rose-900 mb-1 flex items-center gap-1.5">
                                                                        <Heart className="w-3 h-3" /> Alergias
                                                                    </p>
                                                                    <p className="text-sm text-rose-800">{pilgrim.allergies}</p>
                                                                </div>
                                                            )}
                                                            {roomInfo.cleanNotes && (
                                                                <div className="bg-slate-50 p-3 rounded-xl border border-slate-200">
                                                                    <p className="text-xs font-bold text-slate-700 mb-1 flex items-center gap-1.5">
                                                                        <FileText className="w-3 h-3" /> Notas Adicionais
                                                                    </p>
                                                                    <p className="text-sm text-slate-600 italic">"{roomInfo.cleanNotes}"</p>
                                                                </div>
                                                            )}
                                                        </div>
                                                    )}
                                                </>
                                            )}
                                        </div>
                                    );
                                })}
                            </div>

                            {/* Payment Section */}
                            <div className="mt-8">
                                <h4 className="text-lg font-bold text-slate-900 flex items-center gap-2 mb-4">
                                    <CreditCard className="w-5 h-5 text-indigo-600" />
                                    Gestão Financeira
                                </h4>
                                <PaymentHistoryManager
                                    bookingId={selectedBooking.id}
                                    totalAmount={selectedBooking.total_amount}
                                    paidAmount={selectedBooking.paid_amount}
                                    paymentPlan={selectedBooking.payment_plan}
                                    onUpdate={() => fetchBookings()}
                                />
                            </div>
                        </div>

                        {/* Modal Footer */}
                        <div className="p-4 bg-white border-t border-slate-200 flex justify-end">
                            <button
                                onClick={() => setSelectedBooking(null)}
                                className="px-6 py-2 bg-slate-900 text-white rounded-xl font-bold hover:bg-slate-800 transition-all"
                            >
                                Fechar
                            </button>
                        </div>
                    </div>
                </div>
            )}
        </div>
    );
}
