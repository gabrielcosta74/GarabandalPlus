# Application / Supabase
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Stable public host used only in authentication emails. Never set to localhost.
AUTH_PUBLIC_URL=https://apostoladodegarabandal.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin / scheduled workers
ADMIN_EMAIL=
ADMIN_EMAILS=
CRON_SECRET=

# Transactional email
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=
# Caixa geral no admin (/admin/email) — IMAP/SMTP da caixa (hoje Webnode)
MAILBOX_USER=
MAILBOX_PASSWORD=
MAILBOX_FROM_NAME=Apostolado de Garabandal
MAILBOX_IMAP_HOST=imap.mail.webnode.com
MAILBOX_IMAP_PORT=993
MAILBOX_SMTP_HOST=smtp.mail.webnode.com
MAILBOX_SMTP_PORT=465
# Quem pode reencaminhar faturas de subscrições (Supabase, Vodafone…) para a
# caixa geral@ e vê-las entrar na Contabilidade, além dos ADMIN_EMAIL/S. Separar por vírgulas.
LEDGER_INVOICE_FORWARDERS=

# FACT.pt — segredos apenas no servidor
FACTPT_API_VERSION=1.0.0
FACTPT_TIMEOUT_MS=15000
FACTPT_UNIT_ID=1
FACTPT_SANDBOX_KEY_2026Q=
FACTPT_SANDBOX_KEY_2026L=
FACTPT_SANDBOX_KEY_2026D=
FACTPT_ZERO_TAX_ID_2026D=
FACTPT_SANDBOX_EMAIL_OVERRIDE=

# FACT.pt — produção automática limitada a pagamentos de peregrinações.
# Manter false até chave, unidade, imposto 0%, migration, worker e cron estarem validados.
FACTPT_PRODUCTION_ENABLED=false
FACTPT_PRODUCTION_BASE_URL=https://api.fact.pt
FACTPT_PRODUCTION_KEY_2026D=
FACTPT_PRODUCTION_UNIT_ID=
FACTPT_PRODUCTION_ZERO_TAX_ID_2026D=

# App Garabandal+: id de fornecedor da App Store (App Analytics > Campanhas).
# Com ele, os links /app?src= levam o canal da partilha para as campanhas da Apple.
APP_STORE_PROVIDER_TOKEN=

# Email — Resend e marketing
# Webhook do Resend (Svix): sem isto a rota /api/webhooks/resend responde 500.
RESEND_WEBHOOK_SECRET=
# Segredo próprio dos links de cancelar subscrição (não reutilizar o CRON_SECRET: rodá-lo
# invalidava todas as ligações já enviadas). Ao trocar, pôr o antigo em *_PREVIOUS.
UNSUBSCRIBE_SECRET=
UNSUBSCRIBE_SECRET_PREVIOUS=
# Interruptor global dos envios de marketing (funis, campanhas, Marian, newsletter): 1 = pausado.
MARKETING_SENDING_PAUSED=
# Janela horária de envio em horas de Brasília (início inclusivo-fim exclusivo) e tetos.
MARKETING_SEND_WINDOW=9-20
MARKETING_CRON_DAILY_SEND_CAP=50
MARKETING_FUNNEL_RESERVED_DAILY=20
MARKETING_CRON_BATCH_LIMIT=15
MARKETING_MIN_HOURS_BETWEEN_EMAILS=24
MARKETING_MAX_EMAILS_PER_7D=7
MARKETING_CAMPAIGN_AUDIENCE_LIMIT=100
# Respostas aos emails de marketing e morada legal no rodapé (opcionais).
MARKETING_REPLY_TO=
MARKETING_FOOTER_ADDRESS=
# Onde os crons do Railway chamam a app.
CRON_TARGET_URL=
